    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.12.0",
    "cobblemon": ">=1.7.0",
    "jei": ">=19.0.0"
